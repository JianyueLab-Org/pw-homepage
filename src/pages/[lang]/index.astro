---
import Base from "../../layouts/Base.astro";
import SearchCard from "../../components/SearchCard.astro";
import ArticleList from "../../components/ArticleList.astro";
import Notices from "../../components/Notices.astro";
import { locales, useTranslations, type Lang } from "../../i18n/ui";
import { wikis } from "../../data";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<Base lang={lang} title={`${t("home.title")} | Postal Wiki`} description={t("home.subtitle")}>
  <div class="mx-auto max-w-5xl px-4 pt-6 pb-16 sm:pt-10 md:pb-24">
    <!-- Souvenir sheet: an ultramarine field with the title and subtitle as
         its printed margin inscriptions and the search stamp at its centre. -->
    <section
      class="on-sheet relative bg-sheet px-4 pt-7 pb-6 text-on-sheet sm:px-10 sm:pt-10 sm:pb-8 md:px-14"
    >
      <!-- The sheet's printed frame line. -->
      <div
        class="pointer-events-none absolute inset-2.5 border border-sheet-rule sm:inset-3.5"
        aria-hidden="true"
      >
      </div>

      <div class="relative flex items-baseline justify-between gap-6">
        <h1
          class="font-display text-[2.25rem] font-black uppercase leading-none tracking-tight text-balance [font-stretch:72%] sm:text-6xl"
        >
          {t("home.title")}
        </h1>
        <p
          class="hidden shrink-0 text-xs font-semibold uppercase tracking-[0.16em] text-on-sheet-2 [font-stretch:85%] md:block"
        >
          <span lang="zh-CN">邮政百科</span> · Postal Wiki
        </p>
      </div>

      <div class="relative mt-6 sm:mt-8">
        <SearchCard lang={lang} />
      </div>

      <div
        class="relative mt-6 flex flex-col gap-4 sm:mt-7 sm:flex-row sm:items-end sm:justify-between"
      >
        <p class="text-sm text-balance text-on-sheet-2 sm:text-base">
          {t("home.subtitle")}
        </p>

        <nav aria-label={t("wikis.label")}>
          <ul class="flex flex-wrap gap-3">
            {
              wikis.map((wiki) => (
                <li>
                  <!-- The mask that cuts the perforations would also cut away a
                       focus outline, so it lives on the inner paper, not here. -->
                  <a
                    href={wiki.url}
                    lang={wiki.bcp47}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mounted press focus-ring group block motion-safe:hover:-translate-y-0.5"
                  >
                    <span class="perf perf-sm flex items-center gap-2 bg-paper py-2.5 pr-3.5 pl-4 text-paper-ink">
                    <span class="text-sm font-semibold">{wiki.name}</span>
                    <span class="hidden text-xs text-paper-ink-2 tabular-nums min-[25rem]:inline">
                      {new URL(wiki.url).host}
                    </span>
                    <svg
                      class="h-3.5 w-3.5 shrink-0 text-vermilion transition-translate duration-200 ease-standard motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="square"
                      aria-hidden="true"
                    >
                      <path d="M7 17 17 7M8 7h9v9"></path>
                    </svg>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </section>

    <Notices lang={lang} />
    <ArticleList lang={lang} />
  </div>
</Base>
