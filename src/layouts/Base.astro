---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { locales, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const {
  lang,
  title = "Postal Wiki",
  description = "Search across the Chinese and English Postal Wikis — everything you want to know about postal.",
} = Astro.props;

const htmlLang = (locales.find((l) => l.code === lang) ?? locales[0]).bcp47;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/logo.png", Astro.site).href;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- hreflang alternates -->
    {
      locales.map((l) => (
        <link
          rel="alternate"
          hreflang={l.bcp47}
          href={new URL(`/${l.code}/`, Astro.site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL("/en/", Astro.site).href}
    />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={htmlLang.replace("-", "_")} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- No-FOUC theme: set the class before first paint. -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <!-- Analytics -->
    <script
      is:inline
      defer
      src="https://analyze.jianyuelab.co/script.js"
      data-website-id="5f7bf075-4715-4bee-876d-687ca0297a84"></script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
