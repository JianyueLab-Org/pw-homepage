      <p class="text-sm text-neutral-500 dark:text-neutral-400">
        Postal Wiki is registered trademark of Kyotsu Bussan Co., Ltd.
      </p>
    </div>

    <div class="flex items-center gap-2">
      <LocaleSwitcher lang={lang} />

