---
// Dark-mode toggle. Initial class is applied pre-paint by the inline script in Base.astro.
// Clicking animates a circular reveal of the new theme (View Transitions API),
// falling back to an instant switch when unsupported or reduced-motion is on.
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<button
  id="theme-toggle"
  type="button"
  aria-label={t("theme.toggle")}
  class="press focus-ring group relative inline-flex h-10 w-10 items-center justify-center text-ink-2 hover:bg-leaf-2 hover:text-ink"
>
  <!-- Sun (shown in dark mode, click -> light) -->
  <svg
    class="h-5 w-5 rotate-90 scale-0 opacity-0 transition-[opacity,rotate,scale] duration-250 ease-standard dark:rotate-0 dark:scale-100 dark:opacity-100"
    style="position:absolute"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
  <!-- Moon (shown in light mode, click -> dark) -->
  <svg
    class="h-5 w-5 rotate-0 scale-100 opacity-100 transition-[opacity,rotate,scale] duration-250 ease-standard dark:-rotate-90 dark:scale-0 dark:opacity-0"
    style="position:absolute"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  const toggle = document.getElementById("theme-toggle");
  const REVEAL_MS = 420;
  let revealToken = 0;

  function applyTheme() {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  }

  toggle?.addEventListener("click", () => {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // No fancy reveal when unsupported or the user prefers reduced motion.
    if (!("startViewTransition" in document) || reduceMotion) {
      applyTheme();
      return;
    }

    // Reveal the new theme as an expanding circle centered on the toggle.
    const rect = toggle.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const endRadius = Math.hypot(
      Math.max(x, window.innerWidth - x),
      Math.max(y, window.innerHeight - y),
    );

    // Read the curve from the token rather than restating it here. This is the
    // reveal curve, not the UI curve: it drives a radius, and area grows as r².
    const easing =
      getComputedStyle(document.documentElement)
        .getPropertyValue("--ease-reveal")
        .trim() || "cubic-bezier(0.25, 0.46, 0.45, 0.94)";

    // Flag the reveal so the redundant colour crossfade and the header's
    // per-frame backdrop blur stand down until it finishes. The token guards
    // against a rapid second click clearing the flag out from under the
    // transition that replaced it.
    const root = document.documentElement;
    const token = ++revealToken;
    root.setAttribute("data-vt", "");
    const clear = () => {
      if (token === revealToken) root.removeAttribute("data-vt");
    };

    const transition = document.startViewTransition(() => applyTheme());
    transition.finished.then(clear, clear);
    // `finished` can settle well after the reveal has visually ended, so also
    // clear on the reveal's own animation, and keep a backstop so the flag can
    // never be left up (it disables every transition on the page).
    window.setTimeout(clear, REVEAL_MS + 120);
    transition.ready.then(() => {
      const reveal = document.documentElement.animate(
        {
          clipPath: [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${endRadius}px at ${x}px ${y}px)`,
          ],
        },
        {
          duration: REVEAL_MS,
          easing,
          pseudoElement: "::view-transition-new(root)",
        },
      );
      reveal.finished.then(clear, clear);
    });
  });
</script>
