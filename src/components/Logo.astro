---
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<a
  href={`/${lang}/`}
  class="press focus-ring -mx-1 flex items-center px-1 py-1"
>
  <img src="/logo-header.webp" alt="Postal Wiki" width="343" height="108" class="h-9 w-auto" />
</a>
